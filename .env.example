# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Watch for trailing spaces: they cause confusing auth errors.

# Supabase → Project Settings → API. Safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional; defaults to claude-haiku-5-5 in code.
ANTHROPIC_MODEL=claude-haiku-5-5
