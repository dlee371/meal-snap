# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Watch for trailing spaces: they cause confusing auth errors.
# Everything here is server-only (no NEXT_PUBLIC_ prefix), so none of it reaches the browser.

# Neon → your project → Connect → "Pooled connection" string.
# Change sslmode=require to sslmode=verify-full (full certificate check; avoids a pg warning).
# From Phase 2 this becomes the restricted app_user role (so RLS applies), not neondb_owner.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Better Auth: random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# The app's own URL (your Vercel URL in production).
BETTER_AUTH_URL=http://localhost:3000

# Vercel → project → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_example

# Claude API (server-only secret).
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional; defaults to claude-haiku-5-5 in code.
ANTHROPIC_MODEL=claude-haiku-5-5
# true = return saved sample AI answers instead of calling the API (costs $0).
AI_MOCK=true
